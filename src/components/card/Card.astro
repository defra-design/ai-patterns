---
interface Props {
  title: string;
  href: string;
}

const { title, href } = Astro.props;
---

<div class="dfe-card">
  <div class="dfe-card-container">
    <h3 class="govuk-heading-m">
      <a href={href} class="govuk-link govuk-link--no-visited-state dfe-card-link--header">{title}</a>
    </h3>
    <slot />
  </div>
</div>
