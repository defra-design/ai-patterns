---
import Layout from './Layout.astro';

const { frontmatter, headings } = Astro.props;

// Determine back link based on activeNav
const backLinks = {
	'blog': '/blog/',
	'technical': '/technical/',
	'use-cases': '/use-cases/'
};
const backLink = backLinks[frontmatter.activeNav] || '/';
---

<Layout frontmatter={frontmatter}>
	<div class="govuk-grid-row">
		<div class="govuk-grid-column-two-thirds">
			<a href={backLink} class="govuk-back-link">Back</a>
			<article class="blog-post">
				{frontmatter.date && (
					<p class="govuk-!-margin-bottom-6">
						<time datetime={frontmatter.date} class="govuk-tag">
							{new Date(frontmatter.date).toLocaleDateString('en-GB', { 
								day: 'numeric', 
								month: 'long', 
								year: 'numeric' 
							})}
						</time>
					</p>
				)}
				{(frontmatter.status || frontmatter.category || frontmatter.description) && (
					<blockquote class="govuk-!-margin-bottom-6">
						<dl class="govuk-summary-list govuk-summary-list--no-border">
							{frontmatter.status && (
								<div class="govuk-summary-list__row">
									<dt class="govuk-summary-list__key" style="width: 30%;">Status</dt>
									<dd class="govuk-summary-list__value">
										<strong class={`govuk-tag ${
											frontmatter.status.toLowerCase() === 'stable' ? 'govuk-tag--green' :
											frontmatter.status.toLowerCase() === 'experimental' ? 'govuk-tag--yellow' :
											frontmatter.status.toLowerCase() === 'deprecated' ? 'govuk-tag--red' :
											'govuk-tag--grey'
										}`}>
											{frontmatter.status}
										</strong>
									</dd>
								</div>
							)}
							{frontmatter.category && (
								<div class="govuk-summary-list__row">
									<dt class="govuk-summary-list__key" style="width: 30%;">Category</dt>
									<dd class="govuk-summary-list__value">{frontmatter.category}</dd>
								</div>
							)}
							{frontmatter.description && (
								<div class="govuk-summary-list__row">
									<dt class="govuk-summary-list__key" style="width: 30%;">Description</dt>
									<dd class="govuk-summary-list__value">{frontmatter.description}</dd>
								</div>
							)}
						</dl>
					</blockquote>
				)}
				<slot />
			</article>
		</div>
		<div class="govuk-grid-column-one-third">
			<aside class="toc">
				<h2 class="govuk-heading-s">On this page</h2>
				<nav aria-label="Table of contents">
					<ul class="govuk-list">
						{headings
							.filter(h => h.depth >= 1 && h.depth <= 3)
							.map((heading) => (
								<li class={`toc-depth-${heading.depth}`}>
									<a href={`#${heading.slug}`} class="govuk-link">
										{heading.text}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</aside>
		</div>
	</div>
</Layout>
